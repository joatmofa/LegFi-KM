  "keyFeatures": [
    "Centralized knowledge repository for financial and legal content",
    "Structured taxonomy for regulatory and compliance documents",
    "Full-text search with filters for legal and financial topics",
    "Version-controlled document management with audit trails",
    "Role-based access control for sensitive information",
    "Collaborative review and approval workflows",
    "Integrations with legal and financial data sources",
    "Compliance tracking and reporting dashboards"
  ],
  "publicApiSurface": [
    "GET /api/v1/entries — list knowledge entries",
    "POST /api/v1/entries — create a knowledge entry",
    "GET /api/v1/entries/{id} — retrieve a specific entry",
    "PUT /api/v1/entries/{id} — update an entry",
    "DELETE /api/v1/entries/{id} — delete an entry",
    "GET /api/v1/topics — list topics/categories",
    "GET /api/v1/search?q= — full-text search",
    "GET /api/v1/users — list users (admin only)",
    "POST /api/v1/auth/token — obtain API token"
  ]
}
